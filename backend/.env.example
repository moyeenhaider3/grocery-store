PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/shopkart_db
# required in production; generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
# comma-separated, no trailing slash, never *; Flutter dev runs with --web-port 3000
CORS_ORIGINS=http://localhost:3000
# only read by npm run seed:admin, never commit real values
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
